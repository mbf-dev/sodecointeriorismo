---
import menus from '../data/wp/menus.json';
import Logo from './header/Logo.astro';
import settings from '../data/wp/site-settings.json';
import { decodeHtmlEntities } from '../utils/formatting';

const footerMenu = menus.footer_menu || [];
const legalMenu = menus.legal_menu || [];
const socials = settings.socials || [];
const currentYear = new Date().getFullYear();

// Footer Settings
const footerSettings = settings.footer || {};
const copyrightRaw = footerSettings.copyright || `${currentYear} Sodeco Interiorismo All Rights Reserved.`;
const bgImage = footerSettings.bg_image?.optimized?.src 
             || footerSettings.bg_image?.url ;

// Parse Copyright: Replace **text** with home link
// Matches **content** and renders it as a bold link to /
const copyrightContent = copyrightRaw.replace(/\*\*(.*?)\*\*/g, '<a href="/" class="hover:text-primary transition-colors font-bold">$1</a>');

// Helper to map network to icon class
function getSocialIcon(network: string) {
    const map: Record<string, string> = {
        'instagram': 'icon-[fa6-brands--instagram]',
        'facebook': 'icon-[fa6-brands--facebook]',
        'twitter': 'icon-[fa6-brands--x-twitter]',
        'linkedin': 'icon-[fa6-brands--linkedin]',
        'youtube': 'icon-[fa6-brands--youtube]',
        'tiktok': 'icon-[fa6-brands--tiktok]'
    };
    return map[network.toLowerCase()] || 'icon-[heroicons--link]';
}
---

<footer class="text-neutral-content bg-neutral relative pt-20 pb-10 font-sans">
    <!-- Background Image/Overlay -->
    <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden select-none">
        <img src={bgImage} alt="Background" class="h-full w-full object-cover   bg-black">
        <!-- Added generic opacity/bg-black to ensure text legibility as usually implied by dark mode footers with bg images -->
        <div class="absolute inset-0 bg-neutral/50  "></div>
    </div>
    
    <!-- Top Yellow Decoration -->
    <div class="bg-primary absolute -top-8 left-1/2 z-20 h-16 w-[7px] -translate-x-1/2 rounded-2xl"></div>
    
    <div class="relative z-10 container mx-auto flex flex-col items-center px-6">
        
        <!-- Navigation Links (Footer Menu) -->
        <nav class="mb-14 flex flex-wrap justify-center gap-x-8 gap-y-4">
            {footerMenu.map((item) => (
                <a 
                    href={item.url} 
                    class="hover:text-primary text-neutral-content text-md font-bold tracking-wide transition-colors"
                >
                    {decodeHtmlEntities(item.title)}
                </a>
            ))}
        </nav>
       
        <!-- Logo Area -->
        <Logo class="mb-10" imageClass="w-auto h-10 md:h-12" theme="light"  device="desktop"/>
       
        <!-- Social Icons -->
        <div class="mb-16 flex items-center gap-8">
            {socials.map((social) => (
                <a 
                    href={social.url} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="h-6 w-6 transition-colors hover:text-primary text-neutral-content flex items-center justify-center"
                    aria-label={`Visítanos en ${social.network}`}
                >
                   <span class={`${getSocialIcon(social.network)} size-6`}></span>
                </a>
            ))}
        </div>
        
        <!-- Copyright -->
        <div class="text-neutral-content mb-6 text-sm tracking-wide">
            <span set:html={copyrightContent} />
        </div>
        
        <!-- Legal Links -->
        <div class="flex flex-wrap items-center justify-center gap-4 text-sm">
             {legalMenu.map((item, index) => (
                <>
                    <a href={item.url} class="hover:text-primary text-neutral-content transition-colors">
                        {decodeHtmlEntities(item.title)}
                    </a>
                    {index < legalMenu.length - 1 && (
                         <div class="bg-neutral-content h-4 w-0.5"></div>
                    )}
                </>
             ))}
        </div>
    </div>
</footer>
