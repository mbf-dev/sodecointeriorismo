---

<label class="btn btn-circle btn-ghost bg-base-200 hover:bg-base-200 swap swap-rotate border-0 shadow-none">
  <!-- this hidden checkbox controls the state -->
  <input type="checkbox" id="theme-toggle" class="theme-controller" />

    <!-- moon icon (visible when light mode is ON) -->
  <span class="icon-[iconamoon--mode-dark-light] size-7 swap-off"></span>

  <!-- sun icon (visible when dark mode is ON) -->
  <span class="icon-[iconamoon--mode-light-light] size-7 swap-on"></span>


</label>

<script is:inline>
  // Script para manejar el tema y su persistencia
  // Se ejecuta inline para evitar FOUC (Flash of Unstyled Content) lo más posible dentro del componente
  (function() {
      const themeToggle = document.getElementById("theme-toggle");
      const html = document.documentElement;
      
      const savedTheme = localStorage.getItem("theme");
      const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      const currentTheme = savedTheme || systemTheme;

      // 1. Aplicar tema inmediatamente
      html.setAttribute("data-theme", currentTheme);

      // 2. Sincronizar estado del checkbox
      if (themeToggle) {
          themeToggle.checked = currentTheme === "dark";

          // 3. Listener para cambios
          themeToggle.addEventListener("change", (e) => {
              const newTheme = e.target.checked ? "dark" : "light";
              html.setAttribute("data-theme", newTheme);
              localStorage.setItem("theme", newTheme);
          });
      }
  })();
</script>
