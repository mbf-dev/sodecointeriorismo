---
import siteSettings from '../../data/wp/site-settings.json';

const { logos } = siteSettings;

// Helper to get logo src - handles both optimized and direct URL formats
const getLogoSrc = (logo: any) => {
  if (!logo) return '/images/logo-placeholder.svg';
  // If optimized exists (raster images), use that
  if (logo.optimized?.src) return logo.optimized.src;
  // Otherwise use direct URL (SVGs)
  return logo.url || '/images/logo-placeholder.svg';
};

// Logos (handle both formats)
const desktop = getLogoSrc(logos?.desktop);
const mobile = getLogoSrc(logos?.mobile);

const { class: className, imageClass = "h-10", theme = 'auto', device = 'auto' } = Astro.props;

// Determine invert class based on theme prop
const themeClass: Record<string, string> = {
  'auto': 'dark:invert',
  'light': 'brightness-0 invert',
  'dark': ''
};
const textClass = themeClass[theme] || 'dark:invert';

// Device Visibility Classes
// auto: standard responsive behavior
// desktop: force show desktop logo always
// mobile: force show mobile logo always
const desktopVisibility = device === 'desktop' ? 'block' : (device === 'mobile' ? 'hidden' : 'hidden md:block');
const mobileVisibility = device === 'mobile' ? 'block' : (device === 'desktop' ? 'hidden' : 'block md:hidden');
---

<a href="/" class:list={["flex items-center gap-2", className]}>
  
  <!-- Desktop -->
  <img 
    src={desktop} 
    width="150" 
    height="40" 
    alt="Sodeco Logo" 
    class:list={[desktopVisibility, "", textClass, imageClass]} 
  />

  <!-- Mobile -->
  <img 
    src={mobile} 
    width="150" 
    height="40" 
    alt="Sodeco Logo" 
    class:list={[mobileVisibility, "", textClass, imageClass]} 
  />
</a>
